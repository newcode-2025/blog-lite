<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bloglite.mapper.AdminRoleMapper">

    <sql id="roleFilters">
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="keywords != null and keywords != ''">
                AND (
                    role_code LIKE CONCAT('%', #{keywords}, '%')
                    OR role_name LIKE CONCAT('%', #{keywords}, '%')
                )
            </if>
        </where>
    </sql>

    <select id="selectAdminRoles"
            resultType="com.example.bloglite.entity.Role">
        SELECT
            id,
            role_code,
            role_name,
            description,
            status,
            created_at,
            updated_at
        FROM rbac_role
        <include refid="roleFilters"/>
        ORDER BY id ASC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countAdminRoles" resultType="long">
        SELECT COUNT(*)
        FROM rbac_role
        <include refid="roleFilters"/>
    </select>

    <select id="selectEnabledRoleOptions"
            resultType="com.example.bloglite.dto.AdminRoleOptionDTO">
        SELECT
            id,
            role_code AS role_code,
            role_name AS role_name,
            status
        FROM rbac_role
        WHERE status = 1
        ORDER BY id ASC
    </select>

</mapper>
