<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.bloglite.mapper.ArticleMapper">

    <!-- 文章列表返回结构 -->
    <resultMap id="ArticleCardResultMap"
               type="com.example.bloglite.dto.ArticleCardDTO">

        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="categoryName" column="category_name"/>
        <result property="isTop" column="is_top"/>
        <result property="isFeatured" column="is_featured"/>
        <result property="publishedAt" column="published_at"/>

        <!-- 一篇文章对应多个标签 -->
        <collection property="tags"
                    ofType="com.example.bloglite.dto.TagDTO">
            <id property="id" column="tag_id"/>
            <result property="name" column="tag_name"/>
        </collection>
    </resultMap>

    <!-- 文章详情返回结构 -->
    <resultMap id="ArticleDetailResultMap"
               type="com.example.bloglite.dto.ArticleDetailDTO">

        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="content" column="content"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="categoryName" column="category_name"/>
        <result property="isTop" column="is_top"/>
        <result property="isFeatured" column="is_featured"/>
        <result property="viewCount" column="view_count"/>
        <result property="publishedAt" column="published_at"/>

        <collection property="tags"
                    ofType="com.example.bloglite.dto.TagDTO">
            <id property="id" column="tag_id"/>
            <result property="name" column="tag_name"/>
        </collection>
    </resultMap>

    <!-- 分页查询公开文章 -->
    <select id="selectArticleCards"
            resultMap="ArticleCardResultMap">

        SELECT
            a.id,
            a.title,
            a.summary,
            a.cover_url,
            a.is_top,
            a.is_featured,
            a.published_at,
            c.name AS category_name,
            t.id AS tag_id,
            t.name AS tag_name
        FROM article a
                 LEFT JOIN category c
                           ON c.id = a.category_id
                 LEFT JOIN article_tag art_tag
                           ON art_tag.article_id = a.id
                 LEFT JOIN tag t
                           ON t.id = art_tag.tag_id
        WHERE a.is_deleted = 0
          AND a.status = 1
        ORDER BY
            a.is_top DESC,
            a.is_featured DESC,
            a.published_at DESC,
            a.id DESC
            LIMIT #{offset}, #{size}
    </select>

    <!-- 查询公开文章总数 -->
    <select id="countPublishedArticles" resultType="long">
        SELECT COUNT(DISTINCT a.id)
        FROM article a
        WHERE a.is_deleted = 0
          AND a.status = 1
    </select>
    <!-- 根据ID查询公开文章详情 -->
    <select id="selectArticleDetailById"
            resultMap="ArticleDetailResultMap">

        SELECT
            a.id,
            a.title,
            a.summary,
            a.content,
            a.cover_url,
            a.is_top,
            a.is_featured,
            a.view_count,
            a.published_at,
            c.name AS category_name,
            t.id AS tag_id,
            t.name AS tag_name
        FROM article a
                 LEFT JOIN category c
                           ON c.id = a.category_id
                 LEFT JOIN article_tag art_tag
                           ON art_tag.article_id = a.id
                 LEFT JOIN tag t
                           ON t.id = art_tag.tag_id
        WHERE a.id = #{id}
          AND a.is_deleted = 0
          AND a.status = 1
    </select>

</mapper>