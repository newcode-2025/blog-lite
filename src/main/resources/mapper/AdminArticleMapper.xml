<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.bloglite.mapper.AdminArticleMapper">

    <!-- 后台文章列表返回结构 -->
    <resultMap id="AdminArticleListItemResultMap"
               type="com.example.bloglite.dto.AdminArticleListItemDTO">

        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="status" column="status"/>
        <result property="isTop" column="is_top"/>
        <result property="isFeatured" column="is_featured"/>
        <result property="viewCount" column="view_count"/>
        <result property="publishedAt" column="published_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 后台文章列表公共筛选条件 -->
    <sql id="AdminArticleWhere">
        WHERE a.is_deleted = 0
        AND a.author_id = #{authorId}

        <if test="status != null">
            AND a.status = #{status}
        </if>

        <if test="keywords != null and keywords != ''">
            AND (
            a.title LIKE CONCAT('%', #{keywords}, '%')
            OR a.summary LIKE CONCAT('%', #{keywords}, '%')
            )
        </if>
    </sql>

    <!-- 分页查询当前用户的文章 -->
    <select id="selectAdminArticles"
            resultMap="AdminArticleListItemResultMap">

        SELECT
        a.id,
        a.title,
        a.summary,
        a.category_id,
        c.name AS category_name,
        a.status,
        a.is_top,
        a.is_featured,
        a.view_count,
        a.published_at,
        a.created_at,
        a.updated_at
        FROM article a
        LEFT JOIN category c
        ON c.id = a.category_id

        <include refid="AdminArticleWhere"/>

        ORDER BY
        a.updated_at DESC,
        a.id DESC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 统计当前用户符合条件的文章数量 -->
    <select id="countAdminArticles"
            resultType="long">

        SELECT COUNT(*)
        FROM article a

        <include refid="AdminArticleWhere"/>
    </select>

</mapper>